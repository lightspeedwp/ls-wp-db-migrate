{
  "version": "1.0.0",
  "projectName": "ls-wp-db-migrate",
  "projectDescription": "WordPress database migration skill for Claude",
  "defaultModel": "claude-opus-5-5",
  "codeStyle": {
    "indentation": "spaces",
    "indentSize": 2,
    "lineLength": 120,
    "trailingComma": "es5"
  },
  "testing": {
    "framework": "jest",
    "coverage": {
      "branches": 34,
      "functions": 46,
      "lines": 45,
      "statements": 45,
      "note": "Floor at today's coverage of lib/ and api/; keep in step with package.json and raise it as tests are added."
    },
    "integration": {
      "framework": "bats",
      "command": "npm run test:bats"
    },
    "commands": {
      "unit": "npm test",
      "watch": "npm run test:watch",
      "coverage": "npm test -- --coverage",
      "integration": "npm run test:bats",
      "all": "npm run test:all"
    }
  },
  "git": {
    "commitFormat": "conventional",
    "hooks": {
      "preCommit": "lefthook: prettier, markdownlint, jest, eslint, shellcheck",
      "prePush": "lefthook: branch name check"
    },
    "branchPattern": "{type}/{scope}-{title}"
  },
  "permissions": {
    "allowedDomains": ["github.com", "api.github.com"],
    "requiredTools": ["bash", "node", "npm", "git"],
    "restrictedOperations": ["force-push", "hard-reset"]
  },
  "documentation": {
    "location": "docs/",
    "readmeLocation": "README.md",
    "structure": {
      "rootDocs": ["README.md", "CLAUDE.md", "AGENTS.md", "SKILL.md"],
      "guidedFolders": {
        "docs": "Documentation and guides",
        "sub-skills": "Stage sub-skills (preflight, prepare, import, verify, recover)",
        "scripts": "Shell scripts the skill runs",
        "lib": "Node helpers (sql-tool.cjs)",
        "api": "Budgeted migration API",
        "scripts/__tests__": "Jest tests",
        "tests": "BATS integration tests",
        "evals": "Eval cases",
        "plugin": "Plugin manifest",
        ".claude-plugin": "Claude plugin and marketplace manifests",
        "references": "External resources",
        "assets": "Media and templates"
      }
    }
  },
  "skills": {
    "location": "sub-skills",
    "enabled": [
      "ls-wp-db-migrate-import",
      "ls-wp-db-preflight",
      "ls-wp-db-prepare",
      "ls-wp-db-recover",
      "ls-wp-db-verify"
    ]
  },
  "agents": {
    "location": ".claude/agents",
    "enabled": ["wp-db-migrate-developer"]
  }
}
